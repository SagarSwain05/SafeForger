  "anomaly_injection_profiles": {
    "gas_leak_slow": {
      "description": "Slow CH4 leak — below single-sensor threshold, compound risk with hot work",
      "sensor": "CH4",
      "rate_per_tick": 0.8,
      "target_value": 14.0,
      "duration_ticks": 30
    },
    "o2_depletion": {
      "description": "O2 depletion in confined space — maintenance work",
      "sensor": "O2",
      "rate_per_tick": -0.12,
      "target_value": 17.5,
      "duration_ticks": 25
    },
    "h2s_spike": {
      "description": "Sudden H2S release from drain — pump work in progress",
      "sensor": "H2S",
      "rate_per_tick": 1.5,
      "target_value": 8.5,
      "duration_ticks": 15
    },
    "bearing_fault": {
      "description": "Bearing degradation — vibration signature escalating",
      "sensor": "VIBRATION",
      "rate_per_tick": 0.15,
      "target_value": 9.2,
      "duration_ticks": 40
    }
