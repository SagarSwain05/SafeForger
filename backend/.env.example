PORT=5001
# Comma-separated dashboard origins for CORS (localhost is always allowed)
FRONTEND_URL=http://localhost:3000
PUBLIC_DASHBOARD_URL=http://localhost:3000

# Sessions: set a long random string so logins survive restarts
JWT_SECRET=

# Persistence (optional). Without it, users and custom sites live in DATA_DIR/safeforge-db.json
MONGO_URI=
MONGO_DB=safeforge
DATA_DIR=./data

# Email verification + password reset through Brevo (optional; verification is disabled without it)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=SafeForge Nexus

# Demo account (re-seeded at every boot)
DEMO_EMAIL=safeforgerdemo@gmail.com
DEMO_PASSWORD=Safeforger@20226

MQTT_ENABLED=true
MQTT_PORT=1883

# Gemini (optional). Either GEMINI_KEY_1..5 or a comma-separated list:
GEMINI_API_KEYS=

# Optional real alert delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
